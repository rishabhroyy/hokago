# hokago — drop-in environment template. Copy to .env ONLY if you want to
# customize defaults (paths, port, TZ). Every value has a compose default —
# the template boots bare with config in ./data/config and media in
# ./data/media/*. Referenced by docker-compose.yml.

# Where /config lives on the host (db, artwork, fonts, themes, cache, logs).
# Must be a local POSIX filesystem — not NFS/SMB/exFAT.
HOKAGO_CONFIG_DIR=./data/config

# Media roots. These are libraries: the host dir is mounted read-only into a
# FIXED container path (/media/movies, /media/tv, /media/anime), and that
# container path is what the setup wizard records as the library root.
# Point each at your media folders. Want more than three libraries? Add a
# mount line like the ones in docker-compose.yml and enter the matching
# target path in the wizard.
MEDIA_MOVIES_PATH=./data/media/movies
MEDIA_TV_PATH=./data/media/tv
MEDIA_ANIME_PATH=./data/media/anime

POSTGRES_PASSWORD=hokago

HOKAGO_PORT=3000

# Image tag to run (defaults to latest). Pin a specific release to upgrade
# deliberately, e.g. HOKAGO_VERSION=v0.1.0.
# HOKAGO_VERSION=latest

# Optional — unset it and the API auto-generates a random signing secret on
# first boot and persists it (server_settings), like immich. Set it only to
# pin your own (needed when running multiple API replicas):
#   openssl rand -hex 32
# HOKAGO_JWT_SECRET=

# linuxserver convention. Declared for future file-permission work — art and
# media files are currently owned by whatever UID created them on the host.
# /config/db is a documented exception, owned by Postgres's own UID.
PUID=1000
PGID=1000

TZ=UTC