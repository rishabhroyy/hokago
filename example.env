# hokago — copy this file to `.env`, next to docker-compose.yml.
#
# REQUIRED: the compose file loads it (`env_file: .env`) and refuses to
# start without it. every value is prefilled with a sane default, so an
# unedited copy just runs — the only thing most people change is the
# MEDIA_* paths below.

# --- media libraries (the one thing you most likely want) -----------------
# the left side is your folder. the container path after the colon is
# fixed — the setup wizard asks you for those /media/... paths.
# want more libraries? add a volume line to BOTH services in
# docker-compose.yml (hokago and hokago-worker), e.g.
#   - /mnt/storage/concerts:/media/concerts:ro
MEDIA_MOVIES_PATH=./data/media/movies
MEDIA_TV_PATH=./data/media/tv
MEDIA_ANIME_PATH=./data/media/anime

# where hokago keeps its data: database, posters, fonts, downloads
HOKAGO_CONFIG_DIR=./data/config

# the port the web ui + api listen on
HOKAGO_PORT=3000

# postgres password — leave as-is unless you connect to the database from
# the host. only A-Za-z0-9, no special characters
POSTGRES_PASSWORD=hokago

# which published image version to run — omit for latest
#HOKAGO_VERSION=v0.1.0

# behind nginx/caddy/another proxy? uncomment to make login rate-limiting
# see real client ips (see the README, "behind a reverse proxy")
#HOKAGO_TRUST_PROXY=true

# hardware transcoding: "auto" (default) detects whatever gpu the container
# can see; "none" forces cpu only; pick a specific one with vaapi/qsv/nvenc.
# intel/amd gpus need nothing else — /dev/dri is already granted by the
# compose file. nvidia needs the host toolkit + the `gpus: all` line
# uncommented in docker-compose.yml.
#HOKAGO_HWACCEL=auto

# override the detected gpu device — a non-default render node for intel/amd
# (e.g. /dev/dri/renderD129) or a cuda card index for nvidia (e.g. 1)
#HOKAGO_HWACCEL_DEVICE=

# normally left unset — the api generates its own random signing secret on
# first boot and remembers it. pin it only for multi-replica deployments.
#HOKAGO_JWT_SECRET=change-me-to-something-long

# job concurrency (the worker's defaults are tuned for a 4-8 core box):
#   HOKAGO_SCAN_CONCURRENCY   libraries scanning in parallel (default 2)
#   HOKAGO_ARTWORK_CONCURRENCY  parallel ffmpeg artwork jobs (default 8)
#   HOKAGO_TRICKPLAY_CONCURRENCY parallel trickplay sheet jobs (default 8)
#   HOKAGO_DOWNLOAD_CONCURRENCY  parallel download encodes (default 2)
#   HOKAGO_MAX_TRANSCODES     concurrent playback transcodes (default 4)
#   HOKAGO_METADATA_SWEEP_MS  how often unresolved items retry (default 30min)
#HOKAGO_SCAN_CONCURRENCY=2
#HOKAGO_ARTWORK_CONCURRENCY=8
#HOKAGO_TRICKPLAY_CONCURRENCY=8
#HOKAGO_DOWNLOAD_CONCURRENCY=2
#HOKAGO_MAX_TRANSCODES=4
#HOKAGO_METADATA_SWEEP_MS=1800000

# the ports below are published for host-side tooling and can be commented
# out entirely for a locked-down deploy
#POSTGRES_PORT=5432
#VALKEY_PORT=6379

# file ownership inside the containers — declared now, enforced later
#PUID=1000
#PGID=1000

# timezone for container clocks
#TZ=UTC