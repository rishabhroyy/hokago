<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Hokago" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/hokago_bg</item>
        <item name="android:colorBackground">@color/hokago_bg</item>
        <item name="colorPrimary">@color/hokago_accent</item>
        <item name="colorAccent">@color/hokago_accent</item>
        <!-- Edge-to-edge: transparent bars, light icons (the app is dark) —
             the webview content pads itself via the injected safe-area vars. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>