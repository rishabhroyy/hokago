<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash: the app's charcoal (no white flash before Flutter's first
     frame) with the hokago mark centered. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/hokago_bg" />
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
