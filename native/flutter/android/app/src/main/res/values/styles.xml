<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- hokago is dark-only (CLAUDE.md #6): one theme regardless of the OS
         setting. LaunchTheme shows until Flutter's first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI while it initializes and runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/hokago_bg</item>
    </style>
</resources>
