<?xml version="1.0" encoding="utf-8"?>
<!-- tv flavor overlay — merged onto src/main's manifest by Gradle. Adds the
     leanback launcher entry point so the app shows up on Android TV's home
     screen; the phone flavor keeps the regular LAUNCHER-only manifest. The
     launcher banner is @drawable/tv_banner (main manifest). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
