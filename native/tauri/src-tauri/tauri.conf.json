{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hokago",
  "version": "0.2.0",
  "identifier": "com.hokago.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "hokago",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "hokago media server client",
    "icon": ["icons/icon.png"]
  }
}