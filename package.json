{
  "name": "hokago",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev:web": "pnpm --filter @hokago/web dev",
    "docker:up": "docker compose up -d",
    "docker:rebuild": "docker compose build && docker compose up -d --force-recreate",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.5"
  },
  "packageManager": "pnpm@11.13.1"
}
