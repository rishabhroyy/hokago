// hokago — canonical data model
// This file is the source of truth for types.
//
// INVARIANTS (do not violate):
// - No music. Ever. MediaKind is video-only.
// - No email column anywhere.
// - Anime is NOT a MediaKind — it is ContentProfile.ANIME on the Library.
// - MediaItem.confidence is DERIVED from Evidence, never authored.
// - Artwork stores bytes locally; never a remote URL.
// - Valkey is a cache. This DB is the source of truth for "what work exists".

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

/// Video only. Music is permanently out of scope .
enum MediaKind {
  MOVIE
  SERIES
  SEASON
  EPISODE
}

/// Drives parser choice and provider order. Anime is a profile, not a kind .
enum ContentProfile {
  GENERAL
  ANIME
}

enum Provider {
  LOCAL // NFO + sidecar artwork
  EMBEDDED // container tags, attached_pic
  GENERATED // ffmpeg-derived
  TVMAZE
  ANILIST
  MAL // via Jikan
  ANIDB // mapping target only; we never call AniDB
  IMDB // datasets, packages-optional
  WIKIDATA
}

enum TitleType {
  PRIMARY
  ROMAJI
  ENGLISH
  NATIVE
  SYNONYM
}

enum CollectionKind {
  FRANCHISE
  MOVIE_SET
}

/// How an item relates to its collection .
enum RelationType {
  MAIN
  MOVIE
  OVA
  SPECIAL
  RECAP // hidden by default — a preference, never a deletion
  SIDE_STORY
  PREQUEL
  SEQUEL
}

/// Evidence signal types, weighted in .
enum SignalType {
  NFO_UNIQUEID // ~certain
  EMBEDDED_TAG // very strong
  SIBLING_CONSISTENCY // strong
  FOLDER_NAME // strong
  PROBE_RUNTIME // strong — the movie/episode discriminator
  FILENAME_PARSE // medium
  TRACK_LANGUAGE // weak
  RESOLUTION_CODEC // weak
  PROVIDER_MATCH // network provider identity match — strong, not certain
}

enum StreamType {
  VIDEO
  AUDIO
  SUBTITLE
  ATTACHMENT
  DATA
}

enum SubtitleFormat {
  ASS
  SSA
  SRT
  VTT
  PGS // bitmap — forces burn-in, kills Direct Play
  VOBSUB
  DVBSUB
}

enum ArtworkKind {
  POSTER // 2:3 — composed, not extracted, when generated
  BACKDROP // 16:9
  STILL // 16:9, episode
  BANNER
  LOGO // never generatable
  THUMB
}

/// Priority order is explicit on Artwork.priority; this records provenance.
enum ArtworkSource {
  LOCAL_SIDECAR // poster.jpg / -poster.jpg — highest
  NFO_URL
  EMBEDDED // attached_pic
  PROVIDER // network, keyless (or optional-key tier)
  GENERATED // always loses to everything else
}

enum SegmentType {
  INTRO
  OUTRO
  RECAP
  PREVIEW
}

/// Cascade order, cheapest first . MANUAL always wins.
enum SegmentSource {
  CHAPTER
  COMMUNITY
  FINGERPRINT
  MANUAL
}

/// Drives metadata_cache TTL . Never a global constant.
enum LifecycleState {
  UNKNOWN
  UNRELEASED
  ONGOING // short TTL, episode list only
  ENDED // infinite TTL
}

/// Poison-pill handling . NEEDS_ATTENTION items must remain playable.
enum ItemState {
  OK
  NEEDS_ATTENTION
}

enum FontFormat {
  WOFF2
  WOFF
  TTF
  OTF
  TTC
}

/// All sources converge on one hash-deduped store served from our origin .
enum FontSource {
  VENDORED // build-time floor — guarantees offline first boot
  SUBTITLE // extracted from MKV/.mks/sibling fonts dir
  USER_DROP // /config/fonts/
}

enum PlaybackMethod {
  DIRECT_PLAY
  DIRECT_STREAM
  REMUX
  TRANSCODE
}

enum TranscodeState {
  QUEUED
  RUNNING
  DONE
  CANCELLED
  FAILED
}

enum PartyState {
  WAITING
  PLAYING
  PAUSED
  ENDED
}

enum ScanMode {
  WATCH_AND_PERIODIC // inotify + periodic fallback
  PERIODIC_ONLY // required for NFS/SMB — inotify silently never fires
  MANUAL
}

/// What kind of client a Device is — drives session labels and the native
/// client suite's platform profile selection (the web app is a Device too).
enum DevicePlatform {
  WEB
  IOS
  IPADOS
  ANDROID
  MACOS
  WINDOWS
  LINUX
  TVOS
  ANDROIDTV
  GOOGLETV
}

/// Lifecycle of a TV-style pairing code (TV shows it, a logged-in phone/PC
/// approves it). APPROVED → the code is bound to an account; the first
/// /auth/pair/status poll after that mints the session and flips COMPLETE
/// (one session per code — a repeated poll can't mint a second one).
enum PairingStatus {
  PENDING
  APPROVED
  COMPLETE
  EXPIRED
}

/// Server-side download job state. The worker owns ffmpeg for the TRANSCODE
/// variant; the artifact dir lives under /config/downloads/<id>.
enum DownloadStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// ACCOUNTS — no email, anywhere, ever.
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  passwordHash String // argon2id
  isAdmin      Boolean   @default(false)
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  profiles     Profile[]
  sessions     Session[]
  invitesMade  Invite[]  @relation("InviteCreator")
  devices      Device[]  @relation("AccountDevices")
  pairingCodes PairingCode[] @relation("PairingAccount")
  downloads    Download[] @relation("AccountDownloads")

  @@map("accounts")
}

model Profile {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @db.Uuid
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String
  avatarPath     String?
  /// Max allowed rating; null = unrestricted.
  maturityRating String?
  /// Free-form UI prefs. Shape owned by packages/contract, not this file.
  prefs          Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  playbackStates PlaybackState[]
  watchDays      WatchDay[]
  playbackSessions PlaybackSession[]
  hostedParties  WatchParty[]    @relation("PartyHost")
  partyMembers   PartyMember[]

  @@unique([accountId, name])
  @@index([accountId])
  @@map("profiles")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @db.Uuid
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  /// Free-text label from legacy/web logins ("web"). Native clients send a
  /// clientKey instead and get a real Device row + this FK.
  device           String?
  deviceId         String?   @db.Uuid
  authDevice       Device?   @relation("authDevice", fields: [deviceId], references: [id], onDelete: SetNull)
  userAgent        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([accountId])
  @@index([expiresAt])
  @@index([deviceId])
  @@map("sessions")
}

/// Invite links. Shared manually (Discord, tailnet, whatever). No email .
model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  createdById String    @db.Uuid
  createdBy   Account   @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("invites")
}

/// A registered client. `clientKey` is a UUID the app generates once at first
/// launch and keeps in its secure store — it survives reinstalls and is how
/// the server recognizes a device across sessions. Sessions created by a
/// client that identifies itself get bound here, so "revoke this device"
/// revokes everything it ever had. Web (no clientKey) never creates one.
model Device {
  id         String         @id @default(uuid()) @db.Uuid
  accountId  String         @db.Uuid
  account    Account        @relation("AccountDevices", fields: [accountId], references: [id], onDelete: Cascade)
  /// Stable per-install client identity, generated by the client.
  clientKey  String         @unique
  /// User-visible name, e.g. "Living Room TV" — editable later if we want.
  name       String
  platform   DevicePlatform
  lastSeenAt DateTime?
  createdAt  DateTime       @default(now())

  sessions  Session[]  @relation("authDevice")
  downloads Download[]

  @@index([accountId])
  @@map("devices")
}

/// TV-style code pairing. The unauthenticated TV creates a PENDING code and
/// polls /auth/pair/status; a logged-in phone/PC verifies it; the first poll
/// after APPROVED mints a session bound to the verifying account's (newly
/// created) Device and marks the code COMPLETE so it can't mint twice.
model PairingCode {
  id         String        @id @default(uuid()) @db.Uuid
  /// 6-digit code shown on the TV screen.
  code       String        @unique
  status     PairingStatus @default(PENDING)
  deviceName String
  platform   DevicePlatform
  /// The TV's clientKey, if it sent one — the verifying session binds to the
  /// Device upserted from it.
  clientKey  String?
  accountId  String?       @db.Uuid
  account    Account?      @relation("PairingAccount", fields: [accountId], references: [id], onDelete: SetNull)
  expiresAt  DateTime
  createdAt  DateTime      @default(now())
  verifiedAt DateTime?
  consumedAt DateTime?

  @@index([status])
  @@map("pairing_codes")
}

/// A user-initiated offline download. The artifact is a directory under
/// /config/downloads/<id>/: media.mp4 (or the original), packaged text
/// subtitle sidecars, and the fonts ASS tracks need. The worker owns the
/// ffmpeg for TRANSCODE variants; the API only tracks + serves the result.
model Download {
  id            String         @id @default(uuid()) @db.Uuid
  accountId     String         @db.Uuid
  account       Account        @relation("AccountDownloads", fields: [accountId], references: [id], onDelete: Cascade)
  deviceId      String         @db.Uuid
  device        Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  mediaItemId   String         @db.Uuid
  mediaItem     MediaItem      @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  mediaFileId   String         @db.Uuid
  mediaFile     MediaFile      @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  /// "original" | "transcode" — the variant the client asked for.
  variant       String
  /// TRANSCODE caps (clamped like playback's normalizeDeviceProfile).
  targetHeight  Int?
  targetBitrateKbps Int?
  /// Subtitle tracks to package as sidecars (text formats only; a bitmap
  /// track is burned into a TRANSCODE variant instead).
  subtitleTrackIds String[]     @default([])
  status        DownloadStatus @default(QUEUED)
  /// Directory under /config/downloads — set when the worker finishes.
  artifactPath  String?
  sizeBytes     BigInt?
  error         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([accountId])
  @@index([deviceId])
  @@map("downloads")
}

// ─────────────────────────────────────────────────────────────────────────────
// LIBRARIES & MEDIA
// ─────────────────────────────────────────────────────────────────────────────

model Library {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
 /// Bind-mount path inside the container, e.g. /media/anime .
  rootPath       String         @unique
  contentProfile ContentProfile @default(GENERAL)
 /// Kinds expected here. A library may hold movies AND series .
  mediaKinds     MediaKind[]
 /// Override of the default provider chain. Empty = use profile default .
  providerOrder  Provider[]
  scanMode       ScanMode       @default(WATCH_AND_PERIODIC)
 /// Probed at runtime, never assumed. Gates NFO/EDL write-back .
  writable       Boolean        @default(false)
 /// Force composed posters even where real art exists — consistency > authenticity .
  composeAllPosters Boolean     @default(false)
  enabled        Boolean        @default(true)
  lastScanAt     DateTime?
  /// Last directory fully completed in the sorted walk order, for scan
 /// resume . Null when idle or a scan finished cleanly.
  scanCursor     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items          MediaItem[]

  @@map("libraries")
}

/// The central entity. Hierarchy: SERIES -> SEASON -> EPISODE. MOVIE is standalone
/// but may also join a Collection — that is how movies live inside series.
model MediaItem {
  id        String    @id @default(uuid()) @db.Uuid
  libraryId String    @db.Uuid
  library   Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  kind      MediaKind

  parentId  String?     @db.Uuid
  parent    MediaItem?  @relation("Hierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaItem[] @relation("Hierarchy")

  title         String
  sortTitle     String
  originalTitle String?
  overview      String?
  year          Int?
  /// Normalized to a 0–10 scale, provider-agnostic. Single aggregate, not per-source (extra Json holds per-provider if ever needed).
  rating        Float?
  genres        String[]     @default([])
  /// Studio or network of record (AniList studios[0], TVmaze network, Jikan studios[0]).
  studio        String?
 /// From ffprobe. THE movie/episode discriminator (c).
  runtimeMs     Int?

  // Promoted out of jsonb: these are sorted and filtered on constantly.
 // Season 00 = specials, per TVDB/Kodi convention .
  seasonNumber   Int?
  episodeNumber  Int?
 /// Absolute numbering. Resolves against seasonal via IdMapping.episodeOffset .
  absoluteNumber Int?

  premieredAt    DateTime?
  lifecycleState LifecycleState @default(UNKNOWN)

  /// DERIVED from Evidence by the resolver. Materialized here for query/sort only.
 /// NEVER author this directly. Recompute from Evidence.
  confidence     Float          @default(0)
  state          ItemState      @default(OK)

  /// Genuinely open fields only. Anything queried gets a real column.
  extra          Json           @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titles            Title[]
  files             MediaFile[]
  externalIds       ExternalId[]
  evidence          Evidence[]
  artwork           Artwork[]
  segments          MediaSegment[]
  playbackStates    PlaybackState[]
  watchDays         WatchDay[]
  collectionEntries CollectionEntry[]
  watchParties      WatchParty[]
  playbackSessions  PlaybackSession[]
  jobFailures       JobFailure[]
  downloads         Download[]

  @@index([libraryId, kind])
  @@index([parentId])
  @@index([sortTitle])
  @@index([kind, confidence])
  @@index([state])
  @@index([parentId, seasonNumber, episodeNumber])
  @@map("media_items")
}

/// Multi-title search: romaji / english / native / synonyms .
/// Add a GIN/pg_trgm index via migration — Prisma can't express it natively.
model Title {
  id          String    @id @default(uuid()) @db.Uuid
  mediaItemId String    @db.Uuid
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  value       String
  type        TitleType
  lang        String? // BCP-47

  @@index([mediaItemId])
  @@index([value])
  @@map("titles")
}

model MediaFile {
  id          String    @id @default(uuid()) @db.Uuid
  mediaItemId String    @db.Uuid
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  /// Absolute path inside the container.
  path      String  @unique
  sizeBytes BigInt
  mtime     DateTime
 /// Rename/move detection without re-import .
  inode     BigInt?
 /// Content hash. The idempotency key for all derived work .
  hash      String?

  container    String?
  durationMs   Int?
  bitrate      Int?
  probedAt     DateTime?
  probeFailed  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  streams        MediaStream[]
  subtitleTracks SubtitleTrack[]
  fonts          MediaFileFont[]
  transcodeJobs  TranscodeJob[]
  playbackSessions PlaybackSession[]
  trickplay      Trickplay?
  downloads      Download[]

  @@index([mediaItemId])
  @@index([hash])
  @@index([inode])
  @@map("media_files")
}

model MediaStream {
  id          String     @id @default(uuid()) @db.Uuid
  mediaFileId String     @db.Uuid
  mediaFile   MediaFile  @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  streamIndex Int
  type        StreamType
  codec       String?
  profile     String?
  lang        String? // BCP-47
  title       String?
  channels    Int?
  sampleRate  Int?
  width       Int?
  height      Int?
  frameRate   Float?
  bitDepth    Int?

  isDefault Boolean @default(false)
  isForced  Boolean @default(false)
  isHearingImpaired Boolean @default(false)

 /// HDR detection gates the whole tone-map chain — SDR skips it entirely .
  /// { colorPrimaries, transfer, matrix, masteringDisplay, contentLightLevel, dv? }
  hdrMeta Json?

  @@unique([mediaFileId, streamIndex])
  @@index([mediaFileId, type])
  @@map("media_streams")
}

// ─────────────────────────────────────────────────────────────────────────────
// COLLECTIONS — how movies live inside series.
// ─────────────────────────────────────────────────────────────────────────────

model Collection {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  sortTitle String
  kind      CollectionKind @default(FRANCHISE)
  overview  String?
  /// True when built from a provider relation graph; false when hand-made.
  derived   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  entries     CollectionEntry[]
  externalIds ExternalId[]
  artwork     Artwork[]

  @@index([sortTitle])
  @@map("collections")
}

/// Many-to-many. A movie is a first-class MOVIE in browse AND an entry here .
model CollectionEntry {
  id           String       @id @default(uuid()) @db.Uuid
  collectionId String       @db.Uuid
  collection   Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mediaItemId  String       @db.Uuid
  mediaItem    MediaItem    @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  relationType RelationType @default(MAIN)
  /// How it shipped.
  releaseOrder Int?
 /// Chronological / recommended watch order. Both stored; user picks .
  storyOrder   Int?
 /// Positions a movie inside a series, e.g. "after S1" → renders inline .
  anchor       String?

  @@unique([collectionId, mediaItemId])
  @@index([collectionId, releaseOrder])
  @@index([collectionId, storyOrder])
  @@index([mediaItemId])
  @@map("collection_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTITY
// ─────────────────────────────────────────────────────────────────────────────

model ExternalId {
  id           String      @id @default(uuid()) @db.Uuid
  mediaItemId  String?     @db.Uuid
  mediaItem    MediaItem?  @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  collectionId String?     @db.Uuid
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  provider   String // Provider enum value; String so packages-optional can extend
  providerId String
  confidence Float  @default(1)
  createdAt  DateTime @default(now())
  // Last time resolveMetadataStep actually evaluated this (mediaItemId,
  // provider) pair against the network — matched, revalidated, or checked and
 // left alone. Drives self-healing's "new evidence since we last looked"
  // and backoff gates; distinct from createdAt (which never changes).
  lastResolvedAt DateTime @default(now())

  @@unique([mediaItemId, provider])
  @@unique([collectionId, provider])
  @@index([provider, providerId])
  @@map("external_ids")
}

/// Mappings are UNIDIRECTIONAL. A→B does not imply B→A — store both .
model IdMapping {
  id             String @id @default(uuid()) @db.Uuid
  sourceProvider String
  sourceId       String
  targetProvider String
  targetId       String

  seasonOffset Int @default(0)
 /// THE load-bearing field. Absolute → seasonal numbering .
  episodeOffset Int @default(0)

 /// Which packages-optional dataset produced this . Null = local/manual.
  datasetSource String?
  fetchedAt     DateTime @default(now())

  @@unique([sourceProvider, sourceId, targetProvider, targetId])
  @@index([sourceProvider, sourceId])
  @@index([targetProvider, targetId])
  @@map("id_mappings")
}

/// Confidence is derived from these rows. Never store a magic number .
/// Re-resolution = recompute from Evidence, which is why this table exists at all.
model Evidence {
  id          String     @id @default(uuid()) @db.Uuid
  mediaItemId String     @db.Uuid
  mediaItem   MediaItem  @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  signalType  SignalType
  source      String // provider name, file path, "probe", etc.
  /// The observed value, e.g. { imdb: "tt0245429" } or { runtimeMs: 6480000 }
  value       Json
  weight      Float
  observedAt  DateTime   @default(now())

  @@index([mediaItemId])
  @@index([mediaItemId, signalType])
  @@map("evidence")
}

// ─────────────────────────────────────────────────────────────────────────────
// JOB ROBUSTNESS
// ─────────────────────────────────────────────────────────────────────────────

/// Durable poison-pill counter . Valkey/BullMQ retry state is a cache
/// and must not be the only place a failure count lives — this survives a
/// Valkey loss so a re-derived job doesn't start back at attempt 1 forever.
model JobFailure {
  id          String    @id @default(uuid()) @db.Uuid
  mediaItemId String    @db.Uuid
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  jobType     String
  attempts    Int       @default(0)
  lastError   String?
  lastFailedAt DateTime @default(now())

  @@unique([mediaItemId, jobType])
  @@map("job_failures")
}

// ─────────────────────────────────────────────────────────────────────────────
// METADATA CACHE & ARTWORK
// ─────────────────────────────────────────────────────────────────────────────

model MetadataCache {
  id         String  @id @default(uuid()) @db.Uuid
  provider   String
  externalId String
  payload    Json
 /// Jikan's Last-Modified header → If-Modified-Since → 304, zero work .
  lastModified String?
  fetchedAt  DateTime @default(now())
 /// TTL derived from lifecycleState, never a global constant .
  ttlPolicy  String
  lifecycleState LifecycleState @default(UNKNOWN)
  expiresAt  DateTime?

  @@unique([provider, externalId])
  @@index([expiresAt])
  @@map("metadata_cache")
}

/// Artwork is stored as BYTES, locally. Never a remote URL. Never hotlinked .
/// This is also what buys COOP/COEP immunity for JASSUB .
/// Polymorphic like ExternalId: belongs to a MediaItem OR a Collection (a
/// franchise gets its own poster, not just a borrowed member's) — never both.
model Artwork {
  id           String        @id @default(uuid()) @db.Uuid
  mediaItemId  String?       @db.Uuid
  mediaItem    MediaItem?    @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  collectionId String?       @db.Uuid
  collection   Collection?   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  kind        ArtworkKind
  source      ArtworkSource
  /// Lower = wins. Derived from source; explicit so resolution is deterministic.
  priority    Int
  /// Path under /config/artwork. The bytes. Not a URL.
  bytesPath   String
  hash        String
  width       Int?
  height      Int?
  sizeBytes   Int?
  /// For GENERATED: { strategy: "blur-extend"|"weighted-crop", sourceFrameMs, score }
  meta        Json?
  createdAt   DateTime      @default(now())

  @@unique([mediaItemId, kind, source])
  @@unique([collectionId, kind, source])
  @@index([mediaItemId, kind, priority])
  @@index([collectionId, kind, priority])
  @@index([hash])
  @@map("artwork")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUBTITLES & FONTS — the shared store is the primitive
// ─────────────────────────────────────────────────────────────────────────────

model SubtitleTrack {
  id          String         @id @default(uuid()) @db.Uuid
  mediaFileId String         @db.Uuid
  mediaFile   MediaFile      @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  lang        String?
  title       String?
  format      SubtitleFormat
  forced      Boolean        @default(false)
  sdh         Boolean        @default(false)
  /// Embedded: stream index. External: null.
  streamIndex Int?
  /// External sidecar or extracted-to-disk path. Embedded-only: null.
  path        String?
 /// PGS/VOBSUB force burn-in and kill Direct Play — flag at scan time .
  requiresBurnIn Boolean     @default(false)
  createdAt   DateTime       @default(now())

  @@index([mediaFileId])
  @@map("subtitle_tracks")
}

/// One hash-deduped store. Four sources, one origin . Path is under /config/store.
model Font {
  hash      String     @id // sha256 of the bytes
  family    String
  subfamily String?
  weight    Int?
  style     String? // normal | italic
  format    FontFormat
  source    FontSource
  path      String
  sizeBytes Int
  /// unicode-range coverage, for subsetted faces.
  unicodeRange String?
  createdAt DateTime   @default(now())

  mediaFiles MediaFileFont[]

  @@index([family])
  @@index([source])
  @@map("fonts")
}

/// Which fonts a file's ASS tracks need. Drives offline download packaging (a).
model MediaFileFont {
  mediaFileId String    @db.Uuid
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  fontHash    String
  font        Font      @relation(fields: [fontHash], references: [hash], onDelete: Cascade)

  @@id([mediaFileId, fontHash])
  @@index([fontHash])
  @@map("media_file_fonts")
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAYBACK, SEGMENTS, PARTIES
// ─────────────────────────────────────────────────────────────────────────────

model PlaybackState {
  id            String    @id @default(uuid()) @db.Uuid
  profileId     String    @db.Uuid
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaItemId   String    @db.Uuid
  mediaItem     MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  positionMs    Int       @default(0)
  durationMs    Int?
  watched       Boolean   @default(false)
  /// How many times this item has been watched to completion (rewatch count).
  playCount     Int       @default(0)
  /// When the most recent completion happened.
  lastWatchedAt DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([profileId, mediaItemId])
  @@index([profileId, updatedAt])
  @@map("playback_state")
}

/// Per-calendar-day watch statistics, aggregated from playback heartbeats —
/// deliberately NOT per-session: the unit of record is (profile, item, day).
model WatchDay {
  id             String    @id @default(uuid()) @db.Uuid
  profileId      String    @db.Uuid
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaItemId    String    @db.Uuid
  mediaItem      MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  /// Calendar day (server-local midnight), the aggregation key.
  date           DateTime  @db.Date
  /// Total watch time credited that day (seek jumps excluded, capped).
  watchedMs      Int       @default(0)
  /// Start of the day's first watch span.
  firstStartedAt DateTime?
  /// End of the day's last watch span — together with firstStartedAt this is
  /// the "start to end" record for that day.
  lastEndedAt    DateTime?
  /// Times this item was completed that day (feeds the rewatch count).
  completions    Int       @default(0)
  updatedAt      DateTime  @updatedAt

  @@unique([profileId, mediaItemId, date])
  @@index([profileId, date])
  @@map("watch_day")
}

/// Cascade: chapter → community → fingerprint. MANUAL always wins .
model MediaSegment {
  id          String        @id @default(uuid()) @db.Uuid
  mediaItemId String        @db.Uuid
  mediaItem   MediaItem     @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  type        SegmentType
  startMs     Int
  endMs       Int
  source      SegmentSource
  confidence  Float         @default(1)
  createdAt   DateTime      @default(now())

  @@unique([mediaItemId, type, source])
  @@index([mediaItemId])
  @@map("media_segments")
}

/// Created for EVERY playback start, including Direct Play — this is what makes
/// "who's watching now" and watch-party correlation possible.
/// A bare sessionKey string on TranscodeJob alone can't attribute a viewer or a
/// Direct Play stream to anyone; this table is the fix.
model PlaybackSession {
  id             String         @id @default(uuid()) @db.Uuid
  profileId      String         @db.Uuid
  profile        Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaItemId    String         @db.Uuid
  mediaItem      MediaItem      @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  mediaFileId    String         @db.Uuid
  mediaFile      MediaFile      @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  method         PlaybackMethod
  deviceProfile  Json
  startedAt      DateTime       @default(now())
  /// Null while playing; set on end/timeout.
  endedAt        DateTime?
  lastHeartbeatAt DateTime      @default(now())
  positionMs     Int            @default(0)
  bandwidthKbps  Int?

  transcodeJobs TranscodeJob[]
  partyMember   PartyMember?

  @@index([profileId, endedAt])
  @@index([mediaItemId])
  @@map("playback_sessions")
}

/// ~6MB/90min at 320x180/10s . One sprite sheet + a VTT-style index per file.
model Trickplay {
  id           String    @id @default(uuid()) @db.Uuid
  mediaFileId  String    @unique @db.Uuid
  mediaFile    MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  tileWidth    Int
  tileHeight   Int
  intervalMs   Int       @default(10000)
  tilesPerSheet Int
 /// Sprite sheet paths under /config/cache — disposable, regenerable .
  sheetPaths   String[]
 /// MediaFile.hash the sheets were generated from — mismatch means regenerate .
  sourceHash   String?
  generatedAt  DateTime  @default(now())

  @@map("trickplay")
}

model TranscodeJob {
  id          String          @id @default(uuid()) @db.Uuid
  sessionId   String          @db.Uuid
  session     PlaybackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mediaFileId String          @db.Uuid
  mediaFile   MediaFile       @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  method      PlaybackMethod
 /// Serialized device profile the decision was made against .
  deviceProfile Json
  state       TranscodeState  @default(QUEUED)
  segmentFrom Int?
  segmentTo   Int?
 /// Tracked so SIGTERM can reap children — orphaned ffmpeg is a classic bug .
  pid         Int?
  startedAt   DateTime?
  endedAt     DateTime?
  lastError   String?
  createdAt   DateTime        @default(now())

  @@index([sessionId])
  @@index([state])
  @@map("transcode_jobs")
}

/// Server is the timekeeper. Key on MEDIA POSITION, never wall clock — participants
/// may be in different transcode states .
model WatchParty {
  id           String     @id @default(uuid()) @db.Uuid
  hostProfileId String    @db.Uuid
  hostProfile  Profile    @relation("PartyHost", fields: [hostProfileId], references: [id], onDelete: Cascade)
  mediaItemId  String     @db.Uuid
  mediaItem    MediaItem  @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  state        PartyState @default(WAITING)
  positionMs   Int        @default(0)
 /// Server clock at last command. Clients self-correct against this .
  issuedAt     DateTime   @default(now())
  inviteCode   String     @unique
  createdAt    DateTime   @default(now())
  endedAt      DateTime?

  members PartyMember[]

  @@index([state])
  @@map("watch_parties")
}

/// Links to PlaybackSession so a participant's transcode state (direct-play
/// vs transcode, current segment) is queryable directly — no undocumented
/// convention inside an opaque key .
model PartyMember {
  partyId   String           @db.Uuid
  party     WatchParty       @relation(fields: [partyId], references: [id], onDelete: Cascade)
  profileId String           @db.Uuid
  profile   Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Set once the member starts playback; null before then. One-to-one —
  /// a member has at most one active session for this party.
  sessionId String?          @unique @db.Uuid
  session   PlaybackSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  joinedAt  DateTime         @default(now())
  ready     Boolean          @default(false)
 /// Last reported position, for stall detection .
  positionMs Int             @default(0)
  reportedAt DateTime        @default(now())

  @@id([partyId, profileId])
  @@index([profileId])
  @@map("party_members")
}

// ─────────────────────────────────────────────────────────────────────────────
// SETTINGS (option (b))
// ─────────────────────────────────────────────────────────────────────────────

/// Server settings. Single row enforced by application logic.
model ServerSetting {
  id        String   @id @default("singleton")
 /// Base path, e.g. "/hokago" .
  basePath  String   @default("/")
 /// Global + per-user transcode caps .
  maxConcurrentTranscodes Int @default(2)
  maxTranscodesPerUser    Int @default(1)
 /// Chromaprint scheduling (tier 3).
  fingerprintEnabled  Boolean @default(false)
  fingerprintThreads  Int     @default(2)
  fingerprintWindow   String? // cron expr, off-peak
  setupCompletedAt    DateTime?
  updatedAt DateTime @updatedAt

  @@map("server_settings")
}

